ummaryLabel":"2026 season stats","news":[{"headline":"LSU standout TE Trey'Dez Green poised for return vs. Auburn","description":"Trey'Dez Green, widely regarded as one of the top tight ends in the country, is poised to return Saturday after missing the past three games with a leg injury.","published":"2026-10-22T01:31:47.000+00:00","url":"https://www.espn.com/college-football/story/_/id/50243513/lsu-tigers-treydez-green-leg-injury-return-auburn","type":"HeadlineNews","byline":"Alex Scarborough","source":"ESPN"},{"headline":"LSU loses defensive back Spears for season with knee injury","description":"LSU defensive back Dashawn Spears will miss the remainder of the season with a knee injury sustained in Saturday's 32-24 loss at Ole Miss, coach Lane Kiffin confirmed Monday.","published":"2026-09-21T18:59:38.000+00:00","url":"https://www.espn.com/college-football/story/_/id/49999880/lsu-loses-defensive-back-spears-season-knee-injury","type":"HeadlineNews","byline":"ESPN","source":"ESPN"},{"headline":"Wake Forest's post-blowout jab at SMU tops college football Week 11 trolls","description":"Wake Forest dominated SMU on the gridiron Saturday -- and added insult to injury after the game.","published":"2026-11-14T23:36:57.000+00:00","url":"https://www.espn.com/college-football/story/_/id/50481104/college-football-trolls-week-11","type":"Story","byline":"ESPN staff","source":"ESPN"},{"headline":"Watch best moments and top plays live from Week 11","published":"2026-11-14T23:16:30.000+00:00","url":"https://www.espn.com/college-football/story/_/id/50474063/week-11-live-highlights","type":"Story","byline":"ESPN staff","source":"ESPN"},{"headline":"Darian Mensah dices up ex-team Duke as Miami rebounds from first loss","description":"Miami quarterback Darian Mensah diced up his former team Saturday, finishing with 382 yards and a touchdown in the 36-25 victory over Duke.","published":"2026-11-14T23:57:48.000+00:00","url":"https://www.espn.com/college-football/story/_/id/50484151/darian-mensah-dices-ex-team-duke-miami-rebounds-first-loss","type":"HeadlineNews","byline":"Andrea Adelson","source":"ESPN"},{"headline":"Wake Forest strengthens CFP case with 'statement' win at SMU","description":"No. 13 Wake Forest made a statement to the College Football Playoff selection committee with a 49-7 blowout of SMU on Saturday.","published":"2026-11-15T00:33:08.000+00:00","url":"https://www.espn.com/college-football/story/_/id/50483729/wake-forest-strengthens-cfp-case-statement-win-smu","type":"HeadlineNews","source":"ESPN"},{"headline":"Vols lose top receiver Matthews to knee injury vs. Texas A&M","description":"Tennessee leading receiver Mike Matthews suffered a right knee injury in the second quarter of Saturday's game at Texas A&M.","published":"2026-11-14T23:16:10.000+00:00","url":"https://www.espn.com/college-football/story/_/id/50483677/vols-lose-top-receiver-matthews-knee-injury-vs-texas-am","type":"HeadlineNews","byline":"Mark Schlabach","source":"ESPN"},{"headline":"Georgia commit, DL Marcellus Young Casario died after 'sudden medical emergency'","description":"Marcellus Young Casario, a Georgia football commit, died Friday after experiencing a \"sudden medical emergency,\" according to his high school.","published":"2026-11-14T20:36:58.000+00:00","url":"https://www.espn.com/college-football/story/_/id/50482223/georgia-football-commit-marcellus-young-casario-dies-suddenly","type":"HeadlineNews","byline":"Eli Lederman","source":"ESPN"},{"headline":"Oklahoma AD rips Ole Miss, SEC; Rebels defend travel effort","description":"Oklahoma AD Roger Denny ripped the SEC and Ole Miss for the \"inexplicable\" decision to move its game to Sunday, while the Rebels defended their travel efforts.","published":"2026-11-14T23:54:22.000+00:00","url":"https://www.espn.com/college-football/story/_/id/50482206/oklahoma-ad-infuriated-sec-ole-miss-sunday-game","type":"HeadlineNews","byline":"Max Olson","source":"ESPN"},{"headline":"Clemson QB Reynolds to have MRI on knee; backup Vizzina (ankle) also hurt","description":"Clemson quarterback Tait Reynolds is having an MRI on his injured knee, and backup Christopher Vizzina was sent to the hospital to evaluate his ankle.","published":"2026-11-14T23:52:45.000+00:00","url":"https://www.espn.com/college-football/story/_/id/50482105/clemson-qb-tait-reynolds-suffers-leg-injury-slide","type":"HeadlineNews","byline":"Andrea Adelson","source":"ESPN"}],"links":{"espn":"https://www.espn.com/college-football/player/_/id/5079420/treydez-green","wikipedia":"https://en.wikipedia.org/wiki/Trey%27Dez_Green"},"pick":{"pick":20,"round":1,"team":"NE","provisional":true},"wiki":{"rules":4,"title":"Trey'Dez Green","url":"https://en.wikipedia.org/wiki/Trey%27Dez_Green","description":"American football player","touched":"2026-11-14T07:37:18Z","intro":"Trey'Dez Green (born February 18, 2006) is an American college football tight end for the LSU Tigers.","sections":[{"key":"early","title":"Early life","text":"Green was born in Jackson, Louisiana. He attended East Feliciana High School in Jackson before transferring to Zachary High School in Zachary, Louisiana for his senior year. He played football and basketball in high school. In football, Green had 45 receptions for 864 yards with 11 touchdowns his junior year and 53 receptions for 960 yards with 12 touchdowns his senior year. He committed to play college football and college basketball at Louisiana State University (LSU)."},{"key":"college","title":"College career","text":"As a true freshman at LSU in 2023, Green played both tight end and wide receiver. He played in all 13 games with two starts and had 13 receptions for 101 yards with four touchdowns. In basketball, he played in six games as a freshman and averaged 1.8 points and 1.7 rebounds."}]}}