pn.com/college-football/story/_/id/50506952/sources-butch-jones-arkansas-state-coach","type":"HeadlineNews","source":"ESPN"},{"headline":"Top 25 betting lines: UGA big faves over Gamecocks, Vols slim favorites vs. LSU","description":"This week's odds and FPI predictions for South Carolina-Georgia, Tennessee-LSU and more.","published":"2026-11-16T23:15:08.000+00:00","url":"https://www.espn.com/espn/betting/story/_/id/50498153/2026-college-football-week-12-top-25-betting-lines-odds","type":"Story","byline":"ESPN","source":"ESPN"},{"headline":"Illinois may turn to third-string QB Boyd after Houser injury","description":"Illinois might turn to third-string quarterback Carson Boyd this week against No. 15 Iowa after starter Katin Houser suffered a broken nose Friday at UCLA that required surgery.","published":"2026-11-16T21:42:38.000+00:00","url":"https://www.espn.com/college-football/story/_/id/50504718/illinois-turn-third-string-qb-boyd-houser-injury","type":"HeadlineNews","byline":"Adam Rittenberg","source":"ESPN"},{"headline":"Rivers says NC State only college job he would have taken","description":"New coach Philip Rivers said NC State was the only college job he would have taken.","published":"2026-11-16T22:20:14.000+00:00","url":"https://www.espn.com/college-football/story/_/id/50504530/rivers-says-nc-state-only-college-job-taken","type":"HeadlineNews","byline":"David Hale","source":"ESPN"},{"headline":"Wake Forest up to No. 10 in AP poll as top teams avoid upsets","description":"Wake Forest's move up to No. 10 was the only week-over-week change atop the AP poll as the top nine teams remained unchanged.","published":"2026-11-16T20:48:17.000+00:00","url":"https://www.espn.com/college-football/story/_/id/50504044/wake-forest-no-10-ap-poll-top-teams-avoid-upsets","type":"HeadlineNews","source":"ESPN"},{"headline":"Texas' Manning to participate in senior day, mum on future","description":"Texas quarterback Arch Manning said Monday he will participate in Saturday's senior day ceremonies despite having one year of eligibility remaining.","published":"2026-11-16T20:31:37.000+00:00","url":"https://www.espn.com/college-football/story/_/id/50503997/texas-arch-manning-participate-senior-day","type":"HeadlineNews","source":"ESPN"},{"headline":"Wisconsin safety Matt Jung to have season-ending ankle surgery","description":"Wisconsin safety Matt Jung will undergo season-ending ankle surgery, the school announced Monday.","published":"2026-11-16T21:10:19.000+00:00","url":"https://www.espn.com/college-football/story/_/id/50503973/wisconsin-safety-matt-jung-season-ending-ankle-surgery","type":"HeadlineNews","source":"ESPN"},{"headline":"Texas DL Hero Kanu undergoes season-ending surgery on arm","description":"Texas starting defensive tackle Hero Kanu had season-ending surgery on his arm Monday, coach Steve Sarkisian announced.","published":"2026-11-16T20:55:33.000+00:00","url":"https://www.espn.com/college-football/story/_/id/50503942/texas-dl-hero-kanu-undergoes-season-ending-surgery-arm","type":"HeadlineNews","byline":"Alex Scarborough","source":"ESPN"},{"headline":"Cignetti: Narrative surrounding Indiana serves as motivation","description":"Indiana coach Curt Cignetti thinks his team's accomplishments continue to be unfairly discredited, and he's using it for motivation as the Hoosiers chase another national title.","published":"2026-11-16T19:38:58.000+00:00","url":"https://www.espn.com/college-football/story/_/id/50503441/narrative-surrounding-indiana-serves-motivation","type":"HeadlineNews","byline":"Adam Rittenberg","source":"ESPN"},{"headline":"AP college football Week 11 poll reaction: What's next for Top 25","description":"A look at the AP rankings, along with a key stat and what's ahead for each team.","published":"2026-11-16T20:51:10.000+00:00","url":"https://www.espn.com/college-football/story/_/id/50484987/week-11-ap-college-football-poll-reaction-next-top-25","type":"Story","byline":"ESPN","source":"ESPN"}],"links":{"espn":"https://www.espn.com/college-football/player/_/id/4833626/ben-roberts","wikipedia":"https://en.wikipedia.org/wiki/Ben_Roberts_(linebacker)"},"wiki":{"rules":4,"title":"Ben Roberts (linebacker)","url":"https://en.wikipedia.org/wiki/Ben_Roberts_(linebacker)","description":"American football player (born 2004)","touched":"2026-11-14T07:37:26Z","intro":"Ben Roberts (born February 28, 2004) is an American football linebacker for the Texas Tech Red Raiders.","sections":[{"key":"early","title":"Early life","text":"Roberts attended V.R. Eaton High School. He committed to play college football for the Texas Tech Red Raiders."},{"key":"college","title":"College career","text":"Roberts used the 2022 season to redshirt. In week two of the 2023 season, Roberts made his first career start, where he notched 12 tackles with two being for a loss, half a sack, and a forced fumble in a loss versus Oregon. He finished the 2023 season, recording a team-high 107 tackles with six and a half being for a loss, half a sack, an interception, and two forced fumbles. For his performance during the 2023 season, Roberts was named to the FWAA freshman all-American team, while also being named the Big 12 Defensive Freshman of the Year. He finished the 2024 season, notching 83 tackles with four and a half going for a loss. In week eleven of the 2025 season, Roberts brought in an interception in a victory versus Kansas State.\nTeaming up at linebacker with Big XII defensive Most Valuable Player Jacob Rodriguez, Roberts led the Red Raiders to a 34–7 win over BYU in the conference championship game on Dec. 6 at Cowboys Stadium. Roberts tallied two interceptions in the second half and was named the game’s MVP."}]}}