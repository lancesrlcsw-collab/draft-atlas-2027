urce":"ESPN"},{"headline":"2027 College Football Playoff National Championship odds","description":"Odds and futures to win the 2027 College Football Playoff National Championship.","published":"2026-11-18T22:17:13.000+00:00","url":"https://www.espn.com/espn/betting/story/_/id/47664633/2027-college-football-playoff-national-championship-odds-futures","type":"Story","byline":"Doug Greenberg","source":"ESPN"}],"links":{"espn":"https://www.espn.com/college-football/player/_/id/5065596/tavion-gadson","wikipedia":"https://en.wikipedia.org/wiki/Tavion_Gadson"},"pick":{"pick":57,"round":2,"team":"KC","provisional":true},"wiki":{"rules":4,"title":"Tavion Gadson","url":"https://en.wikipedia.org/wiki/Tavion_Gadson","description":"American football player","touched":"2026-11-14T07:38:07Z","intro":"Tavion Gadson is an American college football defensive tackle for the Kentucky Wildcats.","sections":[{"key":"early","title":"Early life","text":"Gadson was born in Savannah, Georgia. He attended Jenkins High School in Savannah where as a senior, he was the Region 1-5A Defensive Player of the Year after recording 40 tackles and five sacks. He originally committed to play college football at Florida State University before flipping his commitment to the University of Kentucky."},{"key":"college","title":"College career","text":"Gadson played in four games his first year at Kentucky in 2023 and redshirted. In 2024, he played in only one game after suffering a knee injury during the spring. In 2025, Gadson played in 11 games with one start and had 28 tackles and 2.5 sacks. He returned to Kentucky in 2026."}]}}