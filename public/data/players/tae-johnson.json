es.","published":"2026-09-07T04:18:07.000+00:00","url":"https://www.espn.com/college-football/story/_/id/49855215/brauntae-johnson-jason-onye-exit-notre-dame-opener-early","type":"HeadlineNews","byline":"Adam Rittenberg","source":"ESPN"},{"headline":"Sources: Notre Dame loses safety Luke Talich to torn Achilles","description":"Notre Dame starting safety Luke Talich sustained a torn right Achilles tendon in Saturday's win against SMU, sources told ESPN.","published":"2026-11-22T23:15:45.000+00:00","url":"https://www.espn.com/college-football/story/_/id/50566676/notre-dame-loses-safety-luke-talich-torn-achilles","type":"HeadlineNews","byline":"Pete Thamel and Adam Rittenberg","source":"ESPN"},{"headline":"What Week 12's unexpected results mean for Rivalry Week and beyond","description":"After another chaotic weekend, we look at the playoff and conference races on the line with one game to go.","published":"2026-11-22T23:54:19.000+00:00","url":"https://www.espn.com/college-football/story/_/id/50563018/week-12-results-rivalry-week","type":"Story","byline":"Bill Connelly","source":"ESPN"},{"headline":"2027 recruit AJ Randle Jr. flips from Miami to Notre Dame","description":"Notre Dame coach Marcus Freeman flipped Miami pledge AJ Randle Jr., ESPN's No. 9 outside linebacker in the 2027 recruiting class, to fill a late-cycle need.","published":"2026-11-22T22:48:18.000+00:00","url":"https://www.espn.com/college-football/story/_/id/50565158/2027-recruit-aj-randle-jr-flips-miami-notre-dame","type":"HeadlineNews","byline":"Eli Lederman","source":"ESPN"},{"headline":"Pac-12 reveals unique flex schedule for season's final week","description":"The Pac-12 announced its unique flex schedule for the final week of the regular season early Sunday morning.","published":"2026-11-22T21:20:00.000+00:00","url":"https://www.espn.com/college-football/story/_/id/50564960/pac-12-reveals-unique-flex-schedule-season-final-week","type":"HeadlineNews","source":"ESPN"},{"headline":"Montana State ranked No. 1, 5-7 LIU makes FCS bracket as conference champ","description":"Defending national champion Montana State received the top seed for the 24-team FCS playoffs, while Northeast Conference champion LIU (5-7) became the first playoff team with a losing record since 2017.","published":"2026-11-23T00:02:39.000+00:00","url":"https://www.espn.com/college-football/story/_/id/50564910/montana-state-grabs-top-seed-24-team-fcs-playoff-bracket","type":"HeadlineNews","source":"ESPN"},{"headline":"Wake Forest rewards DC Scottie Hazelton with contract extension","description":"Wake Forest defensive coordinator Scottie Hazelton has signed a contract extension.","published":"2026-11-22T21:20:00.000+00:00","url":"https://www.espn.com/college-football/story/_/id/50564902/wake-forest-rewards-dc-scottie-hazelton-extension","type":"HeadlineNews","byline":"Andrea Adelson","source":"ESPN"},{"headline":"2026 college football coaching carousel: Tracking every open job","description":"As the carousel spins, we'll keep you updated with all the comings and goings.","published":"2026-11-22T20:32:48.000+00:00","url":"https://www.espn.com/college-football/story/_/id/50358611/2026-cfb-coaching-carousel-firings-hirings","type":"Story","byline":"ESPN","source":"ESPN"},{"headline":"Who are the candidates and what are the priorities after TCU fired Sonny Dykes?","description":"Things started well for Dykes, but now the Horned Frogs are looking for a new coach and should have options.","published":"2026-11-22T19:55:28.000+00:00","url":"https://www.espn.com/college-football/story/_/id/50323301/tcu-candidates-personnel-recruits","type":"Story","byline":"Eli Lederman, Max Olson and Adam Rittenberg","source":"ESPN"}],"links":{"espn":"https://www.espn.com/college-football/player/_/id/5218506/brauntae-johnson","wikipedia":"https://en.wikipedia.org/wiki/Brauntae_Johnson"},"pick":{"pick":57,"round":2,"team":"MIN","provisional":true},"wiki":{"rules":4,"title":"Brauntae Johnson","url":"https://en.wikipedia.org/wiki/Brauntae_Johnson","description":"American football player","touched":"2026-11-22T04:18:08Z","intro":"Brauntae Ladarries Johnson, formerly known as Tae Johnson, is an American college football safety for the Notre Dame Fighting Irish.","sections":[{"key":"early","title":"Early life","text":"Johnson attended North Side High School in Fort Wayne, Indiana. He played wide receiver in high school and finished his career with 139 receptions for 2,286 yards and 41 touchdowns. He committed to the University of Notre Dame to play college football. Johnson also played basketball in high school."},{"key":"college","title":"College career","text":"In his first year at Notre Dame in 2024, Johnson missed time after undergoing foot surgery prior to the season. He returned from the injury to play in three games and redshirted. He entered his redshirt freshman season in 2025 as a backup before taking over as starting free safety against Arkansas."}]}}