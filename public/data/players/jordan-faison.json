s":[{"headline":"Notre Dame WR Jordan Faison won't play lacrosse this season","description":"Notre Dame leading wide receiver Jordan Faison will not play lacrosse in 2026 as he focuses solely on football. A midfielder, Faison had 9 goals and 5 assists for the lacrosse team last season.","published":"2026-01-02T17:59:54.000+00:00","url":"https://www.espn.com/college-football/story/_/id/47482708/notre-dame-wr-jordan-faison-play-lacrosse-season","type":"HeadlineNews","byline":"Adam Rittenberg","source":"ESPN"},{"headline":"Notre Dame's Jordan Faison to miss 1-2 weeks with ankle injury","description":"Notre Dame starting wide receiver Jordan Faison suffered a sprained right ankle against Texas A&M and will miss one to two weeks.","published":"2024-09-03T01:37:46.000+00:00","url":"https://www.espn.com/college-football/story/_/id/41097668/notre-dame-jordan-faison-miss-1-2-weeks-ankle-injury","type":"HeadlineNews","byline":"Adam Rittenberg","source":"ESPN"},{"headline":"SEC to consider termination of LSU's membership at Dec. 3 meeting","description":"For the second time this year, the SEC is threatening to hold a vote of its chancellors and presidents on whether to kick LSU out of the league, according to a filing in federal court in Alabama on Monday.","published":"2026-11-24T01:05:52.000+00:00","url":"https://www.espn.com/mens-college-basketball/story/_/id/50577602/sec-consider-termination-lsu-membership","type":"HeadlineNews","byline":"Mark Schlabach","source":"ESPN"},{"headline":"Georgia defensive coordinator Glenn Schumann agrees to coach Florida State","description":"Georgia's Glenn Schumann, one of the country's top defensive coordinators and part of a staff that has the Bulldogs at No. 1 in the CFP rankings, agreed to a five-year deal to become the next coach at Florida State, the school announced Monday.","published":"2026-11-24T00:49:30.000+00:00","url":"https://www.espn.com/college-football/story/_/id/50577665/uga-defensive-coordinator-schumann-coach-florida-state","type":"HeadlineNews","byline":"Andrea Adelson","source":"ESPN"},{"headline":"Aiden Flora, nation's leading rusher, re-signs with Iowa State for next season","description":"Iowa State running back Aiden Flora, who leads the nation in rushing, announced Monday that he has re-signed with the Cyclones for next season.","published":"2026-11-23T23:57:14.000+00:00","url":"https://www.espn.com/college-football/story/_/id/50577520/aiden-flora-nation-leading-rusher-re-signs-iowa-state","type":"HeadlineNews","byline":"David Wilson","source":"ESPN"},{"headline":"Texas A&M names John Thornton interim athletic director effective Dec. 1","description":"John Thornton will take over as interim athletic director at Texas A&M, effective Dec. 1, replacing the departed Trev Alberts.","published":"2026-11-23T22:07:34.000+00:00","url":"https://www.espn.com/college-football/story/_/id/50576559/texas-names-john-thornton-interim-ad-effective-dec-1","type":"HeadlineNews","source":"ESPN"},{"headline":"Sources: Giants DC Dennard Wilson interviews for HC job at alma mater Maryland","description":"Giants defensive coordinator Dennard Wilson had a virtual interview recently for the vacant head coaching job at Maryland, sources told NFL Network.","published":"2026-11-23T21:22:25.000+00:00","url":"https://www.espn.com/nfl/story/_/id/50575838/sources-giants-dennard-wilson-interviews-maryland-job","type":"HeadlineNews","source":"ESPN"},{"headline":"LSU's Lane Kiffin apologizes for using profanity during halftime interview","description":"LSU coach Lane Kiffin has apologized for using profanity during a halftime interview with the school's radio network in Saturday's loss to Tennessee.","published":"2026-11-23T20:12:55.000+00:00","url":"https://www.espn.com/college-football/story/_/id/50575735/lsu-kiffin-apologizes-use-profanity-interview","type":"HeadlineNews","byline":"Mark Schlabach","source":"ESPN"},{"headline":"Wake Forest leading rusher Ty Clark ruled out for season","description":"Wake Forest running back Ty Clark will miss the rest of the season, coach Jake Dickert announced Monday.","published":"2026-11-23T20:30:43.000+00:00","url":"https://www.espn.com/college-football/story/_/id/50575731/wake-forest-leading-rusher-ry-clark-ruled-season","type":"HeadlineNews","byline":"Andrea Adelson","source":"ESPN"},{"headline":"Syracuse rules QB Steve Angeli (shoulder) out vs. Notre Dame","description":"Syracuse has ruled starting quarterback Steve Angeli out for Saturday's game against Notre Dame due to a shoulder injury.","published":"2026-11-23T18:40:45.000+00:00","url":"https://www.espn.com/college-football/story/_/id/50575118/syracuse-rules-qb-steve-angeli-shoulder-vs-notre-dame","type":"HeadlineNews","byline":"Andrea Adelson","source":"ESPN"}],"links":{"espn":"https://www.espn.com/college-football/player/_/id/5150424/jordan-faison","wikipedia":"https://en.wikipedia.org/wiki/Jordan_Faison"},"wiki":{"rules":4,"title":"Jordan Faison","url":"https://en.wikipedia.org/wiki/Jordan_Faison","description":"American football and lacrosse player (born 2004)","touched":"2026-11-14T07:36:20Z","intro":"Quincy Jordan Faison II (born April 7, 2004) is an American college football wide receiver for the Notre Dame Fighting Irish. He previously also played midfielder for the Notre Dame Fighting Irish lacrosse team.","sections":[{"key":"early","title":"Early life","text":"Faison grew up in Weston, Florida and attended the Pine Crest School, where he played basketball, lacrosse, and football. In football, he played safety and quarterback in Pine Crest's Wing T offense and accumulated 1,800 all-purpose yards and scored 26 total touchdowns as a senior. Faison was a three-time All-American in lacrosse."},{"key":"college","title":"College career","text":"Faison entered his freshman football season at Notre Dame as a walk-on before earning a football scholarship midway through the season. He was named the MVP of the 2023 Sun Bowl after catching five passes for 115 yards and a touchdown in a 48–8 win over Oregon State. Faison finished his freshman football season with 19 receptions for 322 yards and four touchdowns.\nFaison was a starting midfielder in his freshman season with the Notre Dame Fighting Irish men's lacrosse team and scored 22 goals. He scored a goal in Notre Dame's 15–5 victory in the 2024 National Championship game against Maryland. He retired from lacrosse in January 2026 to focus fully on football."}]}}