day.","published":"2026-11-19T03:01:31.000+00:00","url":"https://www.espn.com/college-football/story/_/id/50526154/south-carolina-qb-lanorris-sellers-set-play-vs-georgia","type":"HeadlineNews","byline":"Alex Scarborough","source":"ESPN"},{"headline":"NC State names NFL assistant Jason Michael as OC under Philip Rivers","published":"2026-11-19T12:21:56.000+00:00","url":"https://www.espn.com/college-football/story/_/id/50524698/nc-state-names-nfl-assistant-michael-oc-rivers","type":"HeadlineNews","byline":"Andrea Adelson","source":"ESPN"},{"headline":"Georgia AG asks SEC to take action against LSU's 'contempt for the rules'","description":"The Georgia Attorney General blasted LSU in a letter to SEC commissioner Greg Sankey, encouraging sanctions against the Tigers, \"up to and including expulsion.\"","published":"2026-11-19T04:59:20.000+00:00","url":"https://www.espn.com/mens-college-basketball/story/_/id/50524054/georgia-ag-asks-sec-take-action-vs-lsu-expulsion","type":"HeadlineNews","byline":"Mark Schlabach and Pete Thamel","source":"ESPN"},{"headline":"Alabama running back prospect AK Dear no longer with team","description":"Alabama tailback AK Dear, a former four-star prospect who was poised to make an impact before suffering an injury in the summer, is no longer on the team.","published":"2026-11-18T19:16:16.000+00:00","url":"https://www.espn.com/college-football/story/_/id/50523034/alabama-running-back-prospect-ak-dear-no-longer-team","type":"HeadlineNews","byline":"Alex Scarborough","source":"ESPN"}],"links":{"espn":"https://www.espn.com/college-football/player/_/id/5079580/mike-matthews","wikipedia":"https://en.wikipedia.org/wiki/Mike_Matthews_(wide_receiver)"},"wiki":{"rules":4,"title":"Mike Matthews (wide receiver)","url":"https://en.wikipedia.org/wiki/Mike_Matthews_(wide_receiver)","description":"American football player (born 2005)","touched":"2026-11-14T21:00:40Z","intro":"Michael Allen Matthews (born October 25, 2005) is an American college football wide receiver for the Tennessee Volunteers.","sections":[{"key":"early","title":"Early life","text":"Matthews attended Parkview High School in Lilburn, Georgia. He played wide receiver and defensive back in high school. As a senior in 2023, he was the 2023 Region 4-7A Player of the Year after recording 39 receptions for 751 yards and nine touchdowns on offense and 48 tackles and an interception on defense. Matthews played in the 2024 Under Armour All-America Game. A five-star recruit, he committed to the University of Tennessee to play college football."},{"key":"college","title":"College career","text":"Matthews played in 11 games his true freshman year at Tennessee and had seven receptions for 90 yards and two touchdowns. After the season he entered the transfer portal, but removed his name and returned to Tennessee in 2025."}]}}